{
  "name": "Car Wash Planner",
  "short_name": "CarWash",
  "start_url": "./index.html",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "lang": "en",
  "dir": "ltr",
  "iarc_rating_id": "e10+",
  "scope_extensions": [
    { "origin": "https://api.open-meteo.com" },
    { "origin": "https://geocoding-api.open-meteo.com" }
  ],
  "shortcuts": [
    {
      "name": "Check Forecast",
      "url": "./index.html",
      "description": "Check the car wash suitability forecast",
      "icons": [{ "src": "icon_192.png", "sizes": "192x192" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/calendar": [".ics"]
      },
      "icons": [{ "src": "icon_192.png", "sizes": "192x192" }]
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+carwash",
      "url": "./index.html?uri=%s"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "widgets": [
    {
      "name": "Car Wash Forecast",
      "description": "Quick view of the best days to wash your car.",
      "tag": "carwash_widget",
      "ms_ac_template": "widget_template.json",
      "icons": [{ "src": "icon_192.png", "sizes": "192x192" }]
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "background_color": "#e5efee",
  "theme_color": "#0d9488",
  "orientation": "portrait-primary",
  "scope": "./",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon_512.png",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    },
    {
      "src": "icon_192.png",
      "sizes": "192x192",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ],
  "id": "carwash-planner-pwa",
  "categories": [
    "weather",
    "utilities"
  ],
  "description": "A premium, adaptive car wash planning application that recommends the best days to wash your vehicle based on local weather forecasts."
}
